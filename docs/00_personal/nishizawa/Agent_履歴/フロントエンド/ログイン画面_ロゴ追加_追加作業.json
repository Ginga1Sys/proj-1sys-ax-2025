                                  "type": 2,
                                  "priority": 9007199254740991,
                                  "text": "```diff\ndiff --git a/e2e\\tests\\register.test.js b/e2e\\tests\\register.test.js\nnew file mode 100644\n--- /dev/null\n+++ b/e2e\\tests\\register.test.js\n@@ -0,0 +1,136 @@\n+const fetch = require('node-fetch');\r\n+\r\n+// Environment: set BASE_URL to the running backend (default: http://localhost:8080)\r\n+const BASE_URL = process.env.BASE_URL || 'http://localhost:8080';\r\n+\r\n+function randomSuffix() {\r\n+  return Math.random().toString(36).substring(2, 8);\r\n+}\r\n+\r\n+async function postRegister(payload) {\r\n+  const res = await fetch(`${BASE_URL}/api/v1/auth/register`, {\r\n+    method: 'POST',\r\n+    headers: { 'Content-Type': 'application/json' },\r\n+    body: JSON.stringify(payload),\r\n+  });\r\n+  const text = await res.text();\r\n+  let body = null;\r\n+  try { body = JSON.parse(text); } catch (e) { body = text; }\r\n+  return { status: res.status, body };\r\n+}\r\n+\r\n+/* Test: 正常登録\r\n+   - 登録に必要な全フィールドを送り、201 Created とユーザー情報が返ることを確認する */\r\n+test('正常登録: returns 201 and user info', async () => {\r\n+  const suffix = randomSuffix();\r\n+  const payload = {\r\n+    username: `user_${suffix}`,\r\n+    email: `test_${suffix}@ginga.info`,\r\n+    password: 'Aa1!aaaa',\r\n+    displayName: 'テスト ユーザー'\r\n+  };\r\n+  const res = await postRegister(payload);\r\n+  expect(res.status).toBe(201);\r\n+  expect(res.body).toHaveProperty('id');\r\n+  expect(res.body.username).toBe(payload.username);\r\n+  expect(res.body.email).toBe(payload.email);\r\n+});\r\n+\r\n+/* Test: メールドメイン検証\r\n+   - @ginga.info ドメイン以外のメールアドレスを送ると 400 を返す */\r\n+test('メールドメイン検証: invalid domain returns 400', async () => {\r\n+  const payload = {\r\n+    username: `user_bad_${randomSuffix()}`,\r\n+    email: `bad@other.com`,\r\n+    password: 'Aa1!aaaa',\r\n+    displayName: 'Bad Domain'\r\n+  };\r\n+  const res = await postRegister(payload);\r\n+  expect(res.status).toBe(400);\r\n+});\r\n+\r\n+/* Test: パスワード強度検証\r\n+   - 8文字未満や要件未満のパスワードで 400 を返す */\r\n+test('弱パスワード: returns 400', async () => {\r\n+  const payload = {\r\n+    username: `user_weak_${randomSuffix()}`,\r\n+    email: `weak_${randomSuffix()}@ginga.info`,\r\n+    password: 'password',\r\n+    displayName: 'Weak Pass'\r\n+  };\r\n+  const res = await postRegister(payload);\r\n+  expect(res.status).toBe(400);\r\n+});\r\n+\r\n+/* Test: 重複登録\r\n+   - 同一 email で2回登録試行すると2回目は 409 を返す */\r\n+test('重複登録: second registration with same email returns 409', async () => {\r\n+  const suffix = randomSuffix();\r\n+  const payload = {\r\n+    username: `userdup_${suffix}`,\r\n+    email: `dup_${suffix}@ginga.info`,\r\n+    password: 'Aa1!aaaa',\r\n+    displayName: 'Dup User'\r\n+  };\r\n+  const first = await postRegister(payload);\r\n+  expect(first.status).toBe(201);\r\n+  const secondPayload = { ...payload, username: `userdup2_${suffix}` };\r\n+  const second = await postRegister(secondPayload);\r\n+  expect(second.status).toBe(409);\r\n+});\r\n+\r\n+/* Test: 確認トークンフロー\r\n+   - 登録後、テスト用APIでトークンを取得し、確認エンドポイントへアクセスするとユーザーが有効化される */\r\n+test('確認トークンフロー: register -> confirm -> user enabled', async () => {\r\n+  const suffix = randomSuffix();\r\n+  const email = `conf_${suffix}@ginga.info`;\r\n+  const payload = {\r\n+    username: `confuser_${suffix}`,\r\n+    email: email,\r\n+    password: 'Aa1!aaaa',\r\n+    displayName: 'Confirm User'\r\n+  };\r\n+  const first = await postRegister(payload);\r\n+  expect(first.status).toBe(201);\r\n+\r\n+  // retrieve token via test endpoint\r\n+  const tokenRes = await fetch(`${BASE_URL}/api/v1/test/token?email=${encodeURIComponent(email)}`);\r\n+  expect(tokenRes.status).toBe(200);\r\n+  const token = await tokenRes.text();\r\n+\r\n+  // call confirm\r\n+  const confirmRes = await fetch(`${BASE_URL}/api/v1/auth/confirm?token=${encodeURIComponent(token)}`);\r\n+  expect(confirmRes.status).toBe(200);\r\n+\r\n+  // verify user enabled\r\n+  const userRes = await fetch(`${BASE_URL}/api/v1/test/user?email=${encodeURIComponent(email)}`);\r\n+  expect(userRes.status).toBe(200);\r\n+  const user = await userRes.json();\r\n+  expect(user.enabled).toBe(true);\r\n+});\r\n+\r\n+/* Test: メール送信失敗シミュレーション\r\n+   - テスト用APIでメール送信を失敗させても登録は成功し、トークンは作成されることを確認する */\r\n+test('メール送信失敗時も登録は成功しトークンは作成される', async () => {\r\n+  const suffix = randomSuffix();\r\n+  const email = `mailfail_${suffix}@ginga.info`;\r\n+\r\n+  // enable simulated mail failure\r\n+  await fetch(`${BASE_URL}/api/v1/test/mail/fail?enable=true`, { method: 'POST' });\r\n+\r\n+  const payload = {\r\n+    username: `mf_${suffix}`,\r\n+    email: email,\r\n+    password: 'Aa1!aaaa',\r\n+    displayName: 'Mail Fail'\r\n+  };\r\n+  const res = await postRegister(payload);\r\n+  expect(res.status).toBe(201);\r\n+\r\n+  // token should still be created\r\n+  const tokenRes = await fetch(`${BASE_URL}/api/v1/test/token?email=${encodeURIComponent(email)}`);\r\n+  expect(tokenRes.status).toBe(200);\r\n+\r\n+  // disable simulated failure\r\n+  await fetch(`${BASE_URL}/api/v1/test/mail/fail?enable=false`, { method: 'POST' });\r\n+});\n```",
