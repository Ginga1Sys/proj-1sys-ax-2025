                "text": ".container {\r\n  min-height: 100vh;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 48px 16px;\r\n  background: linear-gradient(180deg, #dbefff 0%, #c3ddff 100%);\r\n}\r\n\r\n.title {\r\n  font-size: 1.75rem;\r\n  margin: 0 0 12px 0;\r\n  text-align: center;\r\n  color: #071431;\r\n  font-weight: 700;\r\n}\r\n\r\n.centerCard {\r\n  width: 100%;\r\n  max-width: 760px;\r\n  border-radius: 28px;\r\n  overflow: hidden;\r\n  box-shadow: 0 12px 40px rgba(11,95,255,0.12);\r\n  background: linear-gradient(180deg,#6fb1ff 0%,#86b9ff 100%);\r\n}\r\n\r\n.cardTop {\r\n  padding: 28px 40px;\r\n  background: linear-gradient(180deg, rgba(255,255,255,0.06), transparent 40%);\r\n  position: relative;\r\n}\r\n\r\n.headerIllustration {\r\n  width: 320px;\r\n  height: 88px;\r\n  margin: 0 auto 8px auto;\r\n  border-radius: 12px;\r\n  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.7), transparent 20%), radial-gradient(circle at 70% 30%, rgba(255,255,255,0.5), transparent 15%);\r\n  opacity: 0.9;\r\n}\r\n\n.brandLogo {\n  display: block;\n  width: min(240px, 100%);\n  height: auto;\n  margin: 0 auto 10px auto;\n}\n\r\n.cardTitle {\r\n  text-align: center;\r\n  color: #ffffff;\r\n  font-size: 22px;\r\n  font-weight: 700;\r\n  margin-top: 6px;\r\n}\r\n\r\n.cardBody {\r\n  background: linear-gradient(180deg,#6fb1ff 0%,#86b9ff 100%);\r\n  padding: 32px 40px 40px 40px;\r\n  color: #ffffff;\r\n}\r\n\r\n.formWrap {\r\n  width: 100%;\r\n  max-width: 560px;\r\n  margin: 0 auto 8px auto;\r\n}\r\n\r\n.form {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.field {\r\n  margin-bottom: 14px;\r\n}\r\n\r\n.label {\r\n  display: block;\r\n  margin-bottom: 8px;\r\n  font-weight: 700;\r\n  color: #ffffff;\r\n}\r\n\r\n.input {\r\n  width: 100%;\r\n  padding: 14px 16px;\r\n  border: 1px solid #e6eefb;\r\n  border-radius: 28px;\r\n  font-size: 1rem;\r\n  transition: box-shadow 0.12s ease, border-color 0.12s ease;\r\n  background: #ffffff;\r\n}\r\n\r\n.input:focus {\r\n  outline: none;\r\n  border-color: #7fb5ff;\r\n  box-shadow: 0 6px 20px rgba(11,95,255,0.12);\r\n}\r\n\r\n.toggleButton {\r\n  padding: 10px 12px;\r\n  background: #eef2ff;\r\n  border: 1px solid #dbeafe;\r\n  border-radius: 8px;\r\n  color: #0b5fff;\r\n  cursor: pointer;\r\n}\r\n\r\n.button {\r\n  width: 100%;\r\n  padding: 14px 18px;\r\n  background: linear-gradient(180deg,#f79b3b,#f36e2b);\r\n  color: #fff;\r\n  border: none;\r\n  border-radius: 34px;\r\n  cursor: pointer;\r\n  font-weight: 800;\r\n  font-size: 1.05rem;\r\n}\r\n\r\n.button:disabled {\r\n  opacity: 0.6;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.error {\r\n  color: #b00020;\r\n  margin-bottom: 12px;\r\n  font-weight: 600;\r\n}\r\n\r\n.meta a { color: #0b5fff }\r\n\r\n.fieldError {\r\n  color: #b00020;\r\n  margin-top: 6px;\r\n  font-size: 0.875rem;\r\n}\r\n\r\n.helpBox {\r\n  margin: 18px auto 0 auto;\r\n  max-width: 560px;\r\n  background: #d9e9ff;\r\n  border-radius: 12px;\r\n  padding: 14px 18px;\r\n  text-align: center;\r\n  color: #2b4f74;\r\n}\r\n\r\n.helpSub { margin-top: 6px }\r\n\r\n.helpLink {\r\n  color: #0b5fff;\r\n  font-weight: 600;\r\n  text-decoration: underline;\r\n}\r\n\r\n.fieldHint {\r\n  font-size: 0.8rem;\r\n  font-weight: 400;\r\n  margin-left: 6px;\r\n  opacity: 0.85;\r\n}\r\n\r\n.successMessage {\r\n  background: #d4f0d4;\r\n  border: 1px solid #5bb85b;\r\n  border-radius: 8px;\r\n  color: #1a5c1a;\r\n  padding: 12px 16px;\r\n  margin-bottom: 12px;\r\n  font-size: 0.9rem;\r\n  line-height: 1.5;\r\n}\r\n\r\n.pageHeading {\r\n  text-align: center;\r\n  color: #ffffff;\r\n  font-size: 1.3rem;\r\n  font-weight: 700;\r\n  margin: 0 0 20px 0;\r\n}\r\n",
