                                  "type": 2,
                                  "priority": 9007199254740991,
                                  "text": "```diff\ndiff --git a/__tests__\\LoginForm.test.tsx b/__tests__\\LoginForm.test.tsx\nnew file mode 100644\n--- /dev/null\n+++ b/__tests__\\LoginForm.test.tsx\n@@ -0,0 +1,40 @@\n+import React from 'react'\r\n+import { render, screen, fireEvent } from '@testing-library/react'\r\n+import LoginForm from '../app/components/LoginForm'\r\n+\r\n+describe('LoginForm', () => {\r\n+  test('renders fields and submit button', () => {\r\n+    render(<LoginForm />)\r\n+\r\n+    expect(screen.getByLabelText(/メールアドレス/i)).toBeInTheDocument()\r\n+    expect(screen.getByLabelText(/パスワード/i)).toBeInTheDocument()\r\n+    expect(screen.getByRole('button', { name: /ログイン/i })).toBeInTheDocument()\r\n+  })\r\n+\r\n+  test('shows validation errors when submitting empty form', async () => {\r\n+    render(<LoginForm />)\r\n+\r\n+    const btn = screen.getByRole('button', { name: /ログイン/i })\r\n+    fireEvent.click(btn)\r\n+\r\n+    expect(await screen.findAllByRole('alert')).not.toHaveLength(0)\r\n+  })\r\n+\r\n+  test('calls onSubmit with form data when valid', async () => {\r\n+    const onSubmit = jest.fn().mockResolvedValue(undefined)\r\n+    render(<LoginForm onSubmit={onSubmit} />)\r\n+\r\n+    const emailInput = screen.getByLabelText(/メールアドレス/i)\r\n+    const password = screen.getByLabelText(/パスワード/i)\r\n+    const btn = screen.getByRole('button', { name: /ログイン/i })\r\n+\r\n+    fireEvent.change(emailInput, { target: { value: 'user@example.com' } })\r\n+    fireEvent.change(password, { target: { value: 'password123' } })\r\n+    fireEvent.click(btn)\r\n+\r\n+    // allow promise microtasks\r\n+    await new Promise((r) => setTimeout(r, 0))\r\n+\r\n+    expect(onSubmit).toHaveBeenCalledWith({ email: 'user@example.com', password: 'password123' })\r\n+  })\r\n+})\n```",
