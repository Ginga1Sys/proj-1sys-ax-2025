                                  "type": 2,
                                  "priority": 9007199254740991,
                                  "text": "```diff\ndiff --git a/e2e\\tests\\login.spec.ts b/e2e\\tests\\login.spec.ts\nnew file mode 100644\n--- /dev/null\n+++ b/e2e\\tests\\login.spec.ts\n@@ -0,0 +1,45 @@\n+import { test, expect } from '@playwright/test'\r\n+\r\n+test.describe('Login E2E', () => {\r\n+  test('正常系: ログイン成功でダッシュボードへ遷移', async ({ page }) => {\r\n+    await page.route('**/api/auth/login', route => {\r\n+      route.fulfill({\r\n+        status: 200,\r\n+        contentType: 'application/json',\r\n+        body: JSON.stringify({ token: 'fake-token' }),\r\n+      })\r\n+    })\r\n+\r\n+    await page.goto('/login')\r\n+    await page.fill('input[name=\"identifier\"]', 'user@example.com')\r\n+    await page.fill('input[name=\"password\"]', 'password123')\r\n+    await page.click('button:has-text(\"ログイン\")')\r\n+\r\n+    await expect(page).toHaveURL(/\\/dashboard/)\r\n+  })\r\n+\r\n+  test('異常系: 認証失敗でエラーメッセージ表示', async ({ page }) => {\r\n+    await page.route('**/api/auth/login', route => {\r\n+      route.fulfill({\r\n+        status: 401,\r\n+        contentType: 'application/json',\r\n+        body: JSON.stringify({ message: '認証失敗' }),\r\n+      })\r\n+    })\r\n+\r\n+    await page.goto('/login')\r\n+    await page.fill('input[name=\"identifier\"]', 'bad@example.com')\r\n+    await page.fill('input[name=\"password\"]', 'wrong')\r\n+    await page.click('button:has-text(\"ログイン\")')\r\n+\r\n+    const alert = page.getByRole('alert')\r\n+    await expect(alert).toContainText('認証失敗')\r\n+  })\r\n+\r\n+  test('クライアントバリデーション: 空送信でフィールドエラー表示', async ({ page }) => {\r\n+    await page.goto('/login')\r\n+    await page.click('button:has-text(\"ログイン\")')\r\n+    const alerts = page.getByRole('alert')\r\n+    await expect(alerts).toHaveCount(1)\r\n+  })\r\n+})\n```",
